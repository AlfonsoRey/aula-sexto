    "editor:check": "wrangler deploy --dry-run --config editor/wrangler.jsonc"
  },
  "dependencies": { "jose": "6.2.12" },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "decap-cms": "3.16.3",
    "wrangler": "4.141.0",
    "yaml": "2.8.3"
  }
}
