{
  "name": "aula-sexto",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "validate": "node scripts/validate-content.mjs",
